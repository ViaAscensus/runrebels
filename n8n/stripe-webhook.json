{
  "name": "RunRebels – Stripe Webhook",
  "nodes": [
    {
      "id": "s1",
      "name": "Webhook Stripe",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "rr-stripe",
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "s2",
      "name": "Prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst obj = b.data && b.data.object;\nif (b.type !== 'checkout.session.completed' || !obj || !obj.id) {\n  return [{ json: { ignorieren: true, grund: b.type || 'kein Event' } }];\n}\nreturn [{ json: { ignorieren: false, session_id: obj.id } }];"
      }
    },
    {
      "id": "s3",
      "name": "Relevant?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ignorieren }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "s4",
      "name": "Get Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.stripe.com/v1/checkout/sessions/{{ $json.session_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Stripe test"
        }
      }
    },
    {
      "id": "s5",
      "name": "Session auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "jsCode": "const s = $json;\nconst m = s.metadata || {};\nconst bezahlt = s.payment_status === 'paid' && !!m.bestellung_id && !!m.teilnehmer_id;\nreturn [{ json: {\n  bezahlt,\n  bestellung_id: m.bestellung_id || null,\n  teilnehmer_id: m.teilnehmer_id || null,\n  payment_intent: typeof s.payment_intent === 'string' ? s.payment_intent : (s.payment_intent && s.payment_intent.id) || null\n} }];"
      }
    },
    {
      "id": "s6",
      "name": "Bezahlt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.bezahlt }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "s7",
      "name": "PB Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://pb.runrebels.com/api/collections/_superusers/auth-with-password",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "PocketBase Superuser"
        }
      }
    },
    {
      "id": "s8",
      "name": "Get Bestellung",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pb.runrebels.com/api/collections/bestellungen/records/{{ $('Session auswerten').first().json.bestellung_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('PB Login').first().json.token }}"
            }
          ]
        }
      }
    },
    {
      "id": "s9",
      "name": "Get Teilnehmer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pb.runrebels.com/api/collections/teilnehmer/records/{{ $('Session auswerten').first().json.teilnehmer_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('PB Login').first().json.token }}"
            }
          ]
        }
      }
    },
    {
      "id": "s10",
      "name": "Get Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pb.runrebels.com/api/collections/events/records/{{ $('Get Teilnehmer').first().json.event }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('PB Login').first().json.token }}"
            }
          ]
        }
      }
    },
    {
      "id": "s11",
      "name": "Letzte Startnummer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://pb.runrebels.com/api/collections/teilnehmer/records?perPage=1&sort=-startnummer&fields=startnummer&filter=' + encodeURIComponent('event=\"' + $('Get Teilnehmer').first().json.event + '\" && startnummer!=\"\"') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('PB Login').first().json.token }}"
            }
          ]
        }
      }
    },
    {
      "id": "s12",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        100
      ],
      "parameters": {
        "jsCode": "const be = $('Get Bestellung').first().json;\nconst tn = $('Get Teilnehmer').first().json;\nconst ev = $('Get Event').first().json;\nconst letzte = $('Letzte Startnummer').first().json;\nconst sess = $('Session auswerten').first().json;\nif (be.status === 'bezahlt') return [{ json: { neu: false } }];\nif (!ev.eventskuerzel) throw new Error('events.eventskuerzel ist nicht gesetzt');\nlet nr = tn.startnummer;\nif (!nr) {\n  const items = letzte.items || [];\n  const last = items.length ? parseInt(String(items[0].startnummer).split('-').pop(), 10) : 0;\n  const next = (isNaN(last) ? 0 : last) + 1;\n  nr = ev.eventskuerzel + '-' + String(next).padStart(4, '0');\n}\nreturn [{ json: { neu: true, startnummer: nr, payment_intent: sess.payment_intent } }];"
      }
    },
    {
      "id": "s13",
      "name": "Neu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2640,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.neu }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "s14",
      "name": "Update Teilnehmer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://pb.runrebels.com/api/collections/teilnehmer/records/{{ $('Session auswerten').first().json.teilnehmer_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('PB Login').first().json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'aktiv', startnummer: $('Plan').first().json.startnummer }) }}"
      }
    },
    {
      "id": "s15",
      "name": "Update Bestellung",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://pb.runrebels.com/api/collections/bestellungen/records/{{ $('Session auswerten').first().json.bestellung_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('PB Login').first().json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'bezahlt', stripe_payment_intent_id: $('Plan').first().json.payment_intent }) }}"
      }
    },
    {
      "id": "s18",
      "name": "Mail bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        0
      ],
      "parameters": {
        "jsCode": "\nconst t = $('Get Teilnehmer').first().json;\nconst ev = $('Get Event').first().json;\nconst nr = $('Plan').first().json.startnummer;\nconst kind = t.kategorie === 'kind';\nconst an = kind ? (t.eltern_email || t.email) : t.email;\nconst anrede = kind ? (t.eltern_name || 'du') : (t.name || 'du');\nconst vorname = String(anrede).split(' ')[0];\nconst fmt = (d) => { if (!d) return ''; const x = new Date(String(d).replace(' ', 'T')); if (isNaN(x)) return ''; return x.toLocaleDateString('de-DE', { timeZone: 'Europe/Berlin', day: '2-digit', month: '2-digit', year: 'numeric' }); };\nconst wen = kind ? ('Dein Kind' + (t.name ? ' ' + t.name : '') + ' ist') : 'Du bist';\nconst text = [\n  'Hallo ' + vorname + ',',\n  '',\n  wen + ' dabei. Deine Zahlung ist eingegangen, die Anmeldung für ' + (ev.name || 'die Challenge') + ' steht.',\n  '',\n  'Startnummer: ' + nr,\n  'Zeitraum: ' + fmt(ev.start_date) + ' bis ' + fmt(ev.end_date),\n  '',\n  'Was jetzt kommt: Wir melden uns vor dem Start mit allem, was du zum Einreichen deiner Läufe brauchst. Bis dahin: Schuhe schnüren, Regeln brechen, Kilometer sammeln.',\n  '',\n  'Fragen oder Stornierung (bis Anmeldeschluss' + (ev.anmeldeschluss ? ', ' + fmt(ev.anmeldeschluss) : '') + '): schreib an storno@runrebels.com.',\n  '',\n  'Dein RunRebels-Team',\n  'ein Angebot von ASCENSUS'\n].join('\\n');\nreturn [{ json: { an, betreff: ev.name + ' – du bist dabei (' + nr + ')', text } }];\n"
      }
    },
    {
      "id": "s19",
      "name": "Bestätigung senden",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        3520,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "fromEmail": "RunRebels <runner@runrebels.com>",
        "toEmail": "={{ $json.an }}",
        "subject": "={{ $json.betreff }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP RunRebels"
        }
      }
    },
