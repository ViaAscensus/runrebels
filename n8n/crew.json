      ],
      "parameters": {
        "jsCode": "const rec = ($input.first().json.items || [])[0];\nif (!rec) return [{ json: { aktion: 'fehler' } }];\nif (rec.status === 'bestaetigt') return [{ json: { aktion: 'schon' } }];\nconst now = new Date().toISOString().replace('T', ' ');\nconst stil = rec.stil ? ['', 'Du hast uns geschrieben, wie du läufst: „' + rec.stil + '“. Genau so ist es richtig.'] : [];\nconst abm = 'https://n8n.runrebels.com/webhook/crew-abmelden?t=' + rec.abmelde_token;\nconst text = ['Hallo ' + rec.vorname + ',', '', 'du bist dabei. Willkommen in der Crew.', '',\n  'RunRebels ist Laufen für alle, auf eigene Art. Wie du läufst, entscheidest du. Was gewertet wird, steht vorher fest.'].concat(stil, ['',\n  'Was jetzt kommt: In den nächsten zwei Wochen schreiben wir dir noch zweimal. Erst zeigen wir dir, wer in der Crew läuft und wo du uns findest. Dann erzählen wir, wofür jeder Lauf läuft.', '',\n  'Dein erster Lauf ist der Laufrausch im Januar. Alles dazu: https://runrebels.com/laufrausch/', '',\n  'Allein laufen. Nie allein sein.', '', 'Du willst keine Mails mehr? Hier trägst du dich aus: ' + abm, ''], ['', 'Dein RunRebels-Team', 'ein Angebot von ASCENSUS']).join('\\n');\nreturn [{ json: { aktion: 'ok', id: rec.id, patch: { status: 'bestaetigt', bestaetigt_am: now }, an: rec.email, betreff: 'Willkommen in der Crew, ' + rec.vorname + '.', text } }];"
