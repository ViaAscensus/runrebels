      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://pb.runrebels.com/api/collections/crew/records?perPage=1&filter=' + encodeURIComponent('email=\"' + $('Validate').first().json.data.email + '\"') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('PB Login Eintragen').first().json.token }}"
            }
          ]
        }
      }
    },
    {
      "id": "a6",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "jsCode": "const d = $('Validate').first().json.data;\nconst rec = ($input.first().json.items || [])[0];\nif (rec && rec.status === 'bestaetigt') return [{ json: { aktion: 'skip' } }];   // keine Auskunft, ob die Adresse schon bekannt ist\nconst now = new Date().toISOString().replace('T', ' ');\nconst body = { vorname: d.vorname, email: d.email, stil: d.stil, status: 'unbestaetigt', eingetragen_am: now,\n  einwilligung_text: 'Newsletter-Einwilligung (Double-Opt-in) über runrebels.com, eingetragen ' + now };\nreturn [{ json: { aktion: rec ? 'update' : 'create', id: rec ? rec.id : '', body } }];"
      }
    },
