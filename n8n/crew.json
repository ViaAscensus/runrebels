      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "crew",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://runrebels.com,https://www.runrebels.com"
        }
      },
      "webhookId": "rr-crew"
    },
    {
      "id": "a2",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst s = (v, max=200) => (typeof v === 'string' ? v.trim().slice(0, max) : '');\nconst fail = (m) => [{ json: { fehler: m, status: 400 } }];\nif (s(b.website)) return fail('Eintragung abgelehnt.');                 // Honeypot\nconst vorname = s(b.vorname, 60);\nif (vorname.length < 2) return fail('Bitte trag deinen Vornamen ein.');\nconst email = s(b.email, 200).toLowerCase();\nif (!/^[^@\\s\"'\\\\]+@[^@\\s\"'\\\\]+\\.[^@\\s\"'\\\\]+$/.test(email)) return fail('Bitte prüfen: Bei der E-Mail-Adresse stimmt etwas nicht.');\nif (b.einwilligung !== true) return fail('Bitte bestätige, dass wir dir Neuigkeiten per E-Mail schicken dürfen.');\nconst stil = s(b.stil, 120);\nreturn [{ json: { ok: true, data: { vorname, email, stil } } }];"
      }
    },
    {
      "id": "a3",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
