              "value": "={{ $('PB Login Eintragen').first().json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Plan').first().json.body) }}"
      }
    },
    {
      "id": "a9",
      "name": "DOI-Mail bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "jsCode": "const rec = $input.first().json;\nconst link = 'https://n8n.runrebels.com/webhook/crew-bestaetigen?t=' + rec.token;\nconst text = ['Hallo ' + rec.vorname + ',', '', 'du willst in die Crew von RunRebels. Schön.', '', 'Bestätige kurz deine E-Mail-Adresse, dann bist du drin:', link, '',\n  'Du hast dich nicht eingetragen? Dann ignoriere diese Mail, es passiert nichts.', ''].concat(['', 'Dein RunRebels-Team', 'ein Angebot von ASCENSUS']).join('\\n');\nreturn [{ json: { an: rec.email, betreff: 'Fast in der Crew: bitte bestätige deine E-Mail', text } }];"
      }
    },
    {
      "id": "a10",
      "name": "DOI-Mail senden",
      "type": "n8n-nodes-base.emailSend",
